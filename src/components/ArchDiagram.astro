---
// Diagrama de arquitectura de Aura POS (las líneas con clase "dl" se dibujan al hacer scroll).
---
<div class="overflow-x-auto py-2">
  <svg class="diagram min-w-[620px] w-full max-w-[52rem]" viewBox="0 0 740 230" role="img" aria-label="Arquitectura de Aura POS">
    <text class="dim-t" x="0" y="12">CLIENTES</text><text class="dim-t" x="276" y="12">API</text><text class="dim-t" x="560" y="12">PERSISTENCIA</text>
    <rect class="box" x="0" y="30" width="170" height="54" /><text x="14" y="52">Web</text><text x="14" y="69" class="dim-t">React 19 · Vite</text>
    <rect class="box" x="0" y="106" width="170" height="54" /><text x="14" y="128">Móvil</text><text x="14" y="145" class="dim-t">Expo · React Native</text>
    <rect class="core" x="250" y="40" width="190" height="130" /><text x="266" y="64">NestJS 11</text>
    <text x="266" y="86" class="dim-t">JWT · refresh rotatorio</text>
    <text x="266" y="106" class="dim-t">COMMAND → HANDLER</text><text x="266" y="122" class="dim-t">QUERY → HANDLER</text><text x="266" y="146" class="dim-t">TENANT ID EN CADA CONSULTA</text>
    <rect class="box" x="560" y="30" width="170" height="44" /><text x="574" y="57">PostgreSQL 16</text>
    <rect class="box" x="560" y="94" width="170" height="44" /><text x="574" y="121">Redis 7</text>
    <rect class="box" x="560" y="158" width="170" height="44" /><text x="574" y="185">Cloudflare R2</text>
    <path class="ln dl" d="M170 57H250" /><path class="ln dl" d="M170 133H210V110H250" />
    <path class="ln dl" d="M440 80H500V52H560" /><path class="ln dl" d="M440 105H560" /><path class="ln dl" d="M440 130H500V180H560" />
  </svg>
</div>
